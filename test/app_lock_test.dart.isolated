import 'package:flutter/material.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:expense_tracker/app_lock_wrapper.dart';
import 'package:expense_tracker/features/settings/presentation/settings_providers.dart';

class FakePinLockEnabledNotifier extends PinLockEnabledNotifier {
  FakePinLockEnabledNotifier(bool initial) : super(null) {
    state = initial;
  }
  @override
  void updatePinLockEnabled(bool enabled) => state = enabled;
}

class FakePinHashNotifier extends PinHashNotifier {
  FakePinHashNotifier(String? initial) : super(null) {
    state = initial;
  }
  @override
  void updatePinHash(String? hash) => state = hash;
}

void main() {
  group('App Lock Unit Tests', () {
    test('PIN hashing verification works', () {
      const pin = '1234';
      final hash = hashPin(pin);

      expect(hash, isNotNull);
      expect(hash, isNotEmpty);
      expect(hashPin(pin), equals(hash));
      expect(hashPin('5678'), isNot(equals(hash)));
    });

    test('AppLockNotifier starts locked if initiallyEnabled is true', () {
      final notifier = AppLockNotifier(true);
      expect(notifier.state, isTrue);

      notifier.unlock();
      expect(notifier.state, isFalse);

      notifier.lock();
      expect(notifier.state, isTrue);
    });

    test('AppLockNotifier starts unlocked if initiallyEnabled is false', () {
      final notifier = AppLockNotifier(false);
      expect(notifier.state, isFalse);

      notifier.lock();
      expect(notifier.state, isTrue);

      notifier.unlock();
      expect(notifier.state, isFalse);
    });
  });

  group('App Lock Widget & Lifecycle Tests', () {
    testWidgets('AppLockWrapper triggers lock on background state after 5 seconds', (WidgetTester tester) async {
      await tester.pumpWidget(
        ProviderScope(
          overrides: [
            pinLockEnabledProvider.overrideWith((ref) => FakePinLockEnabledNotifier(true)),
            pinHashProvider.overrideWith((ref) => FakePinHashNotifier(hashPin('1234'))),
            appLockStateProvider.overrideWith((ref) => AppLockNotifier(false)), // starts unlocked
          ],
          child: MaterialApp(
            home: AppLockWrapper(
              child: const Scaffold(
                body: Text('Secret Content'),
              ),
            ),
          ),
        ),
      );

      // Verify it initially shows the child (unlocked)
      expect(find.text('Secret Content'), findsOneWidget);
      expect(find.text('Enter PIN to Unlock'), findsNothing);

      // Simulate app lifecycle going to background (paused)
      tester.binding.handleAppLifecycleStateChanged(AppLifecycleState.paused);
      await tester.pump();

      // Wait 6 seconds (grace period is 5 seconds)
      await tester.pump(const Duration(seconds: 6));

      // Simulate app lifecycle returning to foreground (resumed)
      tester.binding.handleAppLifecycleStateChanged(AppLifecycleState.resumed);
      await tester.pump();
      await tester.pumpAndSettle();

      // Now it should show the LockScreen
      expect(find.text('Secret Content'), findsNothing);
      expect(find.text('Enter PIN to Unlock'), findsOneWidget);

      // Settle the 300ms biometric auto-trigger timer to prevent leaks
      await tester.pump(const Duration(milliseconds: 300));
    });

    testWidgets('AppLockWrapper does NOT trigger lock if background period is under 5 seconds', (WidgetTester tester) async {
      await tester.pumpWidget(
        ProviderScope(
          overrides: [
            pinLockEnabledProvider.overrideWith((ref) => FakePinLockEnabledNotifier(true)),
            pinHashProvider.overrideWith((ref) => FakePinHashNotifier(hashPin('1234'))),
            appLockStateProvider.overrideWith((ref) => AppLockNotifier(false)), // starts unlocked
          ],
          child: MaterialApp(
            home: AppLockWrapper(
              child: const Scaffold(
                body: Text('Secret Content'),
              ),
            ),
          ),
        ),
      );

      // Verify it initially shows the child
      expect(find.text('Secret Content'), findsOneWidget);

      // Pause app
      tester.binding.handleAppLifecycleStateChanged(AppLifecycleState.paused);
      await tester.pump();

      // Wait 3 seconds (less than 5 seconds grace period)
      await tester.pump(const Duration(seconds: 3));

      // Resume app
      tester.binding.handleAppLifecycleStateChanged(AppLifecycleState.resumed);
      await tester.pump();
      await tester.pumpAndSettle();

      // It should STILL show the child (unlocked)
      expect(find.text('Secret Content'), findsOneWidget);
      expect(find.text('Enter PIN to Unlock'), findsNothing);
    });
  });
}
